{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "server.ts",
    "**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
